{
  "name": "counter-display-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/app.ts",
    "sync-admin": "cp \"../后台管理系统/index.html\" public/admin/index.html",
    "build": "tsc && cp -r src/data dist/ && (npm run sync-admin || echo 'sync-admin skipped (source html not found)')",
    "start": "node dist/app.js",
    "migrate": "ts-node src/migrate.ts",
    "import-customers": "ts-node src/importCustomers.ts",
    "dedupe-customers": "ts-node src/dedupeCustomerSpecs.ts"
  },
  "dependencies": {
    "canvas": "^2.11.2",
    "express": "^4.21.0",
    "mysql2": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
